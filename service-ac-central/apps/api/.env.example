PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/service-ac-central

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - domain frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Default admin (dipakai oleh seed script)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=solusiaccentral@gmail.com
SEED_ADMIN_PASSWORD=Admin12345!

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Kode rahasia untuk registrasi admin baru (wajib diisi & dijaga kerahasiaannya)
ADMIN_REGISTRATION_CODE=ganti_dengan_kode_rahasia_kamu

# URL admin panel, dipakai untuk menyusun link reset password
ADMIN_PANEL_URL=http://localhost:5174

# Konfigurasi SMTP (opsional untuk development).
# Kalau dikosongkan, link reset password akan tampil di console log backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Service AC Central <no-reply@serviceaccentral.com>
